# Copia este archivo como .env.local (no se sube al repo) y llena lo que uses.

# Agentes con IA real (sin esto, todo corre en modo simulado)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Panel interno y portal de clientes. En tu máquina (npm run dev) el estudio se abre directo.
ESTUDIO=1
PORTAL=1
ANONYMO_URL=http://localhost:3000

# Estudio en línea (sistema/21): en Vercel el estudio solo se enciende con ESTUDIO=1 + estas tres.
# Clave de cada uno: al menos 12 caracteres. Secreto: al menos 32 caracteres al azar (openssl rand -base64 48).
# Si cambias tu clave, se cierran tus sesiones abiertas. Si las pones en .env.local, también te pedirá entrar en local.
ESTUDIO_CLAVE_JAY=
ESTUDIO_CLAVE_LUNA=
ESTUDIO_SECRETO=

# Avisos (sistema/06): correo con Resend y/o un webhook (Slack, Make, Zapier, WhatsApp...)
RESEND_API_KEY=
AVISOS_CORREO=
AVISOS_DE=
AVISOS_WEBHOOK=

# Costo de IA (sistema/11): USD por millón de tokens y por búsqueda web. Revisa los precios de tu plan.
ANTHROPIC_PRECIO_ENTRADA=3
ANTHROPIC_PRECIO_SALIDA=15
ANTHROPIC_PRECIO_BUSQUEDA=0.01
# Precios del modelo rápido (tareas livianas y decisiones de Atlas, sistema/23)
ANTHROPIC_PRECIO_ENTRADA_RAPIDO=1
ANTHROPIC_PRECIO_SALIDA_RAPIDO=5

# Atlas inteligente (sistema/12): modelo para decisiones cortas (reparto de comentarios). Opcional.
ANTHROPIC_MODEL_RAPIDO=
# Para usar un proxy o un servidor de pruebas en vez de api.anthropic.com. Opcional.
ANTHROPIC_BASE_URL=

# Presupuesto vivo (sistema/15): tu tarifa por hora en USD, para ver el precio en el estudio.
TARIFA_HORA=
# Cómo trabaja la agencia (sistema/29): todos los agentes lo leen. Si no la pones, usa el texto de packages/pipeline/src/agencia.ts
# (producción con IA: una web completa ≈ 3 días; Ecuador; calidad nivel Awwwards sin sumar horas).
ANONYMO_COMO_TRABAJAMOS=

# Almacén privado (sistema/17): bucket PRIVADO de Supabase Storage. La clave de servicio nunca va al navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=proyectos
# En Vercel los proyectos se leen y guardan aquí solos (el disco de Vercel se borra).
# En tu máquina, ANONYMO_NUBE=1 hace que la web local también trabaje contra la nube. Opcional.
ANONYMO_NUBE=
# Opcional: guardar los proyectos fuera del repo (por ejemplo, ~/Anonymo/proyectos)
ANONYMO_PROYECTOS=

# Dominio público de la web (para imágenes al compartir y enlaces en avisos)
# ANONYMO_URL=https://tu-dominio.com

# Precios en la web (web/12): con PRECIOS_PUBLICOS=1 la web muestra rangos por fase (horas típicas × TARIFA_HORA).
PRECIOS_PUBLICOS=

# Analítica (web/19): propia y sin cookies; opcionalmente también Plausible con tu dominio.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
