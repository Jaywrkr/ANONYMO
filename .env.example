# Copia este archivo como .env.local (no se sube al repo) y llena lo que uses.

# Agentes con IA real (sin esto, todo corre en modo simulado)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Panel interno y portal de clientes (solo en tu máquina o servidor privado)
ESTUDIO=1
PORTAL=1
ANONYMO_URL=http://localhost:3000

# Avisos (sistema/06): correo con Resend y/o un webhook (Slack, Make, Zapier, WhatsApp...)
RESEND_API_KEY=
AVISOS_CORREO=
AVISOS_DE=
AVISOS_WEBHOOK=
