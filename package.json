{
  "name": "anonymo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @anonymo/web",
    "build": "npm run build -w @anonymo/web",
    "start": "npm run start -w @anonymo/web",
    "lint": "npm run lint -w @anonymo/web",
    "pipeline": "node packages/pipeline/src/cli.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "probar": "npm run probar -w @anonymo/pipeline",
    "revisar": "npm run revisar -w @anonymo/pipeline"
  }
}
